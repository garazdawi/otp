#!/bin/sh

set -eu

cd "$(git rev-parse --show-toplevel)"

line=$(sed -n '1p' otp_versions.table)
tag=${line%% *}

annotation=$(printf '%s\n' "$line" | awk '
    $2 != ":" || $(NF) != ":" { exit 1 }
    {
        printf "=== %s ===\n\nChanged Applications:\n", $1
        unchanged = 0
        for (i = 3; i < NF; i++) {
            if ($i == "#") {
                printf "\nUnchanged Applications:\n"
                unchanged = 1
            } else {
                printf "- %s\n", $i
            }
        }
        if (!unchanged) exit 1
    }
')

if [ "$1" = "debug" ]; then
    printf '%s\n' "$annotation" && echo "git tag --annotate --file=- \"$tag\""
else
    printf '%s\n' "$annotation" | git tag --annotate --file=- "$tag"
    git branch -f "$1"
fi

